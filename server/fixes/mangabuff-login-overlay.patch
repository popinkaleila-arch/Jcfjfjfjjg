+    async def _clear_login_overlays(self, page: Page) -> None:
+        """Снять оверлеи, перехватывающие клик по кнопке входа на /login.
+
+        На странице живут сразу две формы входа: видимая на самой странице и
+        её копия внутри #modal-auth. Модалка открыта (modal--open), размеры у
+        её полей нулевые, но поддерево перехватывает указатель — клик по
+        видимой кнопке уходил в таймаут. Плюс снизу висит баннер
+        #modal-tenor без кнопки закрытия.
+
+        Вызывается только в логине, поэтому модалки награды не затрагивает.
+        """
+        try:
+            await page.evaluate(
+                """() => {
+                  for (const el of document.querySelectorAll(
+                    '#modal-tenor, #modal-auth, .modal--fixed-bottom'
+                  )) {
+                    el.classList.remove('modal--open');
+                    el.style.display = 'none';
+                  }
+                }"""
+            )
+        except Exception:  # noqa: BLE001
+            pass
+
